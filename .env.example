# Copy to .env.local and fill in for local development.
# In production, set these in the Netlify dashboard
# (Site settings → Environment variables).

# Public — baked into the client bundle at build time.
VITE_RECAPTCHA_SITE_KEY=

# Secret — server-only, used by netlify/functions/submit-lead.ts.
RECAPTCHA_SECRET_KEY=
GHL_WEBHOOK_URL=
