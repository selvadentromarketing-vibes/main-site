{
  "name": "selvadentro-main-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-content.mjs && vite",
    "build": "node scripts/build-content.mjs && vite build && vite build --ssr src/prerender/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/check-static.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "node scripts/build-content.mjs && tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-phone-number-input": "^3.4.13",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@netlify/functions": "^2.8.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.11",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.35",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
